{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenScrcpy",
  "version": "1.1.7",
  "identifier": "dev.yanhenrique.openscrcpy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenScrcpy",
        "width": 1200,
        "height": 890,
        "minWidth": 960,
        "minHeight": 640,
        "visible": true,
        "resizable": true,
        "center": true,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "publisher": "yanhenrique-dev",
    "copyright": "Copyright \u00a9 2026 yanhenrique-dev",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMjc1QThGMzJENDNDN0IKUldSN1BOUXlqMW9uOGlmOUp6OWJRNGlLY21EQ2lQTU41aGppTmZtZVRrcDl1T2gra1c3MVBleVQK",
      "endpoints": [
        "https://v16.next.forgejo.org/UmbrCorp/OpenScrcpy/raw/branch/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
